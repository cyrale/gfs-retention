{
  "name": "@cyrale/gfs-retention",
  "version": "0.1.0",
  "description": "CLI tool that applies a GFS (Grandfather-Father-Son) retention policy to UpdraftPlus backups stored in S3-compatible buckets.",
  "author": {
    "name": "Cyril Jacquesson",
    "site": "https://github.com/cyrale"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "gfs-retention": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "rolldown -c",
    "prepare": "npm run build",
    "start": "npm run build && node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --check src tests",
    "format:fix": "prettier --write src tests",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1171.0",
    "@date-fns/tz": "^1.5.0",
    "commander": "^15.0.0",
    "date-fns": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/ui": "^5.1.1",
    "eslint": "^10.0.1",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "rolldown": "^1.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
