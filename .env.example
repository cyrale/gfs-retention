# Copy this file to .env and fill in the values before running docker compose.
# Never commit the real .env file: it contains secrets.

# S3 connection
S3_ENDPOINT=https://s3.example.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKETS=site-a,site-b
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Retention (daily,weekly,monthly,yearly)
RETENTION=14,8,12,3

# Timezone used for calendar period boundaries
TZ=Europe/Paris

# Cron schedule for the container (default: every day at 04:00)
CRON_SCHEDULE=0 4 * * *

# Set to true to actually delete objects. Leave empty for dry-run.
APPLY=
